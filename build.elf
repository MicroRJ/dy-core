project := elf.load_file("project.elf")
tasks ::= manny.load("c").project_to_tasks(project, {
	output_directory = "build",
	compile_options = [ "/std:c11", "/W4", "/WX", "/Zi", "/Od" ],
})

options := {
	workers = 4,
	verbosity = 0,
}

entries := {}

entries.lib = fun() {
	ret manny.build({ targets = [ tasks.targets.library ], options = options })
}

entries.build = fun() {
	ret manny.build({ targets = [ tasks.default_task ], options = options })
}

entries.test = fun() {
	ret manny.build({ targets = [ tasks.targets.tests ], options = options })
}

ret entries
