library := {
	kind = "static_library",
	name = "dy",
	sources = [
		"src/dy.c",
		"src/dy_stream.c",
		"src/dy_path.c",
		"src/dy_log.c",
		"src/win32/dy_memory.c",
		"src/win32/dy_file.c",
		"src/win32/dy_stream.c",
		"src/win32/dy_path.c",
		"src/win32/dy_env.c",
		"src/win32/dy_process.c",
		"src/win32/dy_thread.c",
		"src/win32/dy_time.c",
		"src/win32/dy_console.c",
		"src/win32/dy_error.c",
	],
	public_include_directories = [
		"include",
	],
}

tests := {
	kind = "test",
	name = "dy_tests",
	sources = [
		"tests/dy_tests.c",
	],
	dependencies = [
		library,
	],
}

ret {
	name = "dy",
	default_target = library,
	targets = {
		library = library,
		tests = tests,
	},
}
