library := {
	kind = "static_library",
	name = "dy",
	sources = {
		"src/dy.c",
		"src/dy_memory.c",
		"src/dy_file.c",
		"src/dy_path.c",
		"src/dy_env.c",
		"src/dy_process.c",
		"src/dy_thread.c",
		"src/dy_time.c",
		"src/dy_console.c",
		"src/dy_log.c",
		"src/dy_error.c",
	},
	public_include_directories = {
		"include",
	},
}

tests := {
	kind = "test",
	name = "dy_tests",
	sources = {
		"tests/dy_tests.c",
	},
	dependencies = {
		library,
	},
}

ret {
	name = "dy",
	default_target = library,
	targets = {
		library = library,
		tests = tests,
	},
}
